# Supabase keys: https://supabase.com/dashboard/project/bmprbjlwzziwnuquobgb/settings/api

# Required
NEXT_PUBLIC_SUPABASE_URL=https://bmprbjlwzziwnuquobgb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

